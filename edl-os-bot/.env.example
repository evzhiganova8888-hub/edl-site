# Скопировать в .env и заполнить секреты.
# Все переменные соответствуют src/core/config.py:Settings.
# Переменные без значения (=) — обязательны для продакшена.

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=edl_os_bot
# Telegram user_id администраторов, через запятую (Катя, Иван)
ADMIN_USER_IDS=
# Chat id для брифов заявок и сервисных уведомлений (Sales-чат)
ADMIN_CHAT_ID=

# --- БД ---
# Для Railway: ${{Postgres.DATABASE_URL}} (Railway reference)
DATABASE_URL=postgresql+asyncpg://edl:edl@postgres:5432/edl
# Для alembic release-фазы (синхронный psycopg, без +asyncpg)
SYNC_DATABASE_URL=postgresql://edl:edl@postgres:5432/edl

# --- Redis ---
# Для Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://redis:6379/0

# --- Anthropic LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=600
# Прокси для оплаты рублями. Убрать, когда появится зарубежная карта.
# Пример: https://api.proxyapi.ru/anthropic
ANTHROPIC_BASE_URL=

# --- Режим оплаты ---
# stub / manual: счёт оформляет Иван вручную, /mark_paid. Инвойс не создаётся.
# yookassa: автоматический инвойс (включить после прохождения модерации).
PAYMENT_MODE=stub

# --- In-bot admin auth ---
# Генерация: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Без значения — /admin_login недоступна.
BOT_ADMIN_ACCESS_KEY=
ADMIN_SESSION_HOURS=8

# --- Legal / ссылки ---
SITE_URL=https://elephantdreams.ru
OFFER_URL=https://elephantdreams.ru/legal/offer.html
OFFER_CHECKUP_URL=https://elephantdreams.ru/legal/offer-checkup-2026-05.html
PRIVACY_POLICY_URL=https://elephantdreams.ru/legal/privacy.html
PRIVACY_POLICY_VERSION=2026-05-11

# --- ЮKassa (заполнить после одобрения магазина) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Бренд / контакты ---
CHANNEL_URL=https://t.me/edl_os
SALES_USERNAME=lvanKhudyakov
CALENDLY_URL=https://calendly.com/evzhiganova8888/30min

# --- Бизнес-флаг (§10 ТЗ v3) ---
# false до 22.05.2026 (NDA). После — переключить через /admin toggle_vitaconsult или UI.
VITACONSULT_PUBLIC=false

# --- Webhook (опционально) ---
# Если задан WEBHOOK_BASE_URL — бот работает через webhook, иначе polling.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET_TOKEN=

# --- Рабочие часы (МСК) ---
WORKING_HOURS_START=10
WORKING_HOURS_END=19
TIMEZONE=Europe/Moscow

# --- Окружение ---
LOG_LEVEL=INFO
ENVIRONMENT=production
